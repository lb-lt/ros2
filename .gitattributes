# 统一换行：ROS 源文件与脚本使用 LF，避免在 Windows 上提交后
# 脚本在 Linux 端因 CRLF 出现 "bad interpreter: /usr/bin/env: ‘python3\r’" 问题。
* text=auto eol=lf

*.py    text eol=lf
*.sh    text eol=lf
*.launch text eol=lf
*.xml   text eol=lf
*.rviz  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.gif   binary
*.pgm   binary
*.npz   binary
